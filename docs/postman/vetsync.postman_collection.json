{
  "info": {
    "name": "VetSync API",
    "description": "Fluxo da demonstração e casos de erro. Requer as variáveis de ambiente base_url, usuario, senha e token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.environment.get(\"token\");",
          "if (token) { pm.request.headers.upsert({ key: \"Authorization\", value: \"Token \" + token }); }",
          "const d = new Date(); d.setDate(d.getDate() - 5);",
          "pm.environment.set(\"data_aplicacao\", d.toISOString().slice(0, 10));",
          "const f = new Date(); f.setDate(f.getDate() + 3);",
          "pm.environment.set(\"data_futura\", f.toISOString().slice(0, 10));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Fluxo da demonstração",
      "item": [
        {
          "name": "01 Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario}}\",\n  \"password\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.environment.set(\"token\", pm.response.json().token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Quem sou eu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/eu/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().organizacao).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Criar tutor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tutores/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Paula Ribeiro\",\n  \"telefone\": \"(19) 99871-2204\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set(\"tutor_id\", pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Buscar tutor",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tutores/?search=Ana"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().count).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Criar vacina",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/vacinas/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Vacina teste {{$randomInt}}\",\n  \"intervalo_dias\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set(\"vacina_id\", pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Criar animal",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/animais/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Mimi\",\n  \"especie\": \"gato\",\n  \"sexo\": \"femea\",\n  \"idade_estimada\": \"2 anos\",\n  \"peso_kg\": \"3.8\",\n  \"tutor\": {{tutor_id}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.environment.set(\"animal_id\", pm.response.json().id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Registrar atendimento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/atendimentos/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"animal\": {{animal_id}},\n  \"data_hora\": \"{{$isoTimestamp}}\",\n  \"anamnese\": \"Apatia e recusa alimentar parcial há 2 dias.\",\n  \"sintomas\": \"Apatia\",\n  \"diagnostico\": \"Gastrite leve a esclarecer\",\n  \"procedimentos\": \"Palpação abdominal\",\n  \"prescricoes\": \"Probiótico por 5 dias\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Registrar vacinação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/vacinacoes/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"animal\": {{animal_id}},\n  \"vacina\": {{vacina_id}},\n  \"data_aplicacao\": \"{{data_aplicacao}}\",\n  \"lote\": \"L-88213\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => {",
                  "  pm.response.to.have.status(201);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.proxima_dose).to.be.a(\"string\");",
                  "  pm.expect(j.situacao).to.eql(\"em_dia\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Histórico do animal",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/animais/{{animal_id}}/historico/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.atendimentos.length).to.eql(1);",
                  "  pm.expect(j.vacinacoes.length).to.eql(1);",
                  "  pm.expect(j.proximas_doses.length).to.eql(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Buscar animal",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/animais/?search=Mimi"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().count).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Casos de erro",
      "item": [
        {
          "name": "E1 Sem login retorna 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/tutores/"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.request.headers.remove(\"Authorization\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => {",
                  "  pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E2 Senha errada retorna 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario}}\",\n  \"password\": \"senha-incorreta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E3 CPF inválido retorna 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tutores/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teste\",\n  \"telefone\": \"1\",\n  \"cpf\": \"12345678901\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json()).to.have.property(\"cpf\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E4 Campos obrigatórios retornam 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/tutores/",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => {",
                  "  pm.response.to.have.status(400);",
                  "  const j = pm.response.json();",
                  "  pm.expect(j).to.have.property(\"nome\");",
                  "  pm.expect(j).to.have.property(\"telefone\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E5 Vacinação futura retorna 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/vacinacoes/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"animal\": {{animal_id}},\n  \"vacina\": {{vacina_id}},\n  \"data_aplicacao\": \"{{data_futura}}\",\n  \"lote\": \"L-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 400\", () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json()).to.have.property(\"data_aplicacao\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E6 Excluir tutor com animal retorna 409",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/tutores/{{tutor_id}}/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", () => {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}